@model string

@{
    var fileName = System.IO.Path.GetFileName((Model ?? string.Empty).Trim().Replace('\\', '/'));
    var imagePath = "~/Content/WineImages/" + (string.IsNullOrWhiteSpace(fileName) ? "no-image-news.png" : fileName);
}

<img src="@Url.Content(imagePath)"
     alt="@(string.IsNullOrWhiteSpace(fileName) ? "Chua co anh" : fileName)"
     style="max-width: 100px; max-height: 120px; object-fit: contain;"
     loading="lazy" />
